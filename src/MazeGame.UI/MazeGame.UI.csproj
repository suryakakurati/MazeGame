<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>MazeGame.UI</RootNamespace>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!-- Public UI types (renderers, input adapters) are documented too. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- The UI may only talk to Core through GameState; see ARCHITECTURE.md. -->
    <ProjectReference Include="..\MazeGame.Core\MazeGame.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Raylib-cs" Version="8.1.0" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The committed atlases are copied beside the executable so a published build (or a plain
      `dotnet run`) finds them; the pixel renderer falls back to the repository path otherwise,
      which is what `dotnet test` relies on.
    -->
    <Content Include="Content/Generated/*.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Content/Generated/manifest.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
